{
  "name": "instant-guest-post-request",
  "version": "0.1.0",
  "description": "Instant Guest Post Request Plugin",
  "scripts": {
    "build:admin": "wp-scripts build ./admin/src/index.js --output-path=admin/js",
    "start:admin": "wp-scripts start ./admin/src/index.js --output-path=admin/js",
    "build:css:admin": "tailwindcss -i ./admin/src/styles/tailwind.css -o ./admin/css/admin.css --minify",
    "build:css:front": "tailwindcss -i ./front/src/styles/tailwind.css -o ./front/css/front.css --minify",
    "build:css": "npm run build:css:admin && npm run build:css:front",
    "watch:css:admin": "tailwindcss -i ./admin/src/styles/tailwind.css -o ./admin/css/admin.css --watch",
    "watch:css:front": "tailwindcss -i ./front/src/styles/tailwind.css -o ./front/css/front.css --watch"
  },
  "devDependencies": {
    "@wordpress/scripts": "^26.0.0",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.2"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}